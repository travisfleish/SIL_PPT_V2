# Sports Innovation Lab PowerPoint Generator - Environment Variables
# Copy this file to .env and fill in your actual values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Snowflake Database Configuration
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_TOKEN=your_snowflake_token_here

# Snowflake Database Details
SNOWFLAKE_DATABASE=your_database_name
SNOWFLAKE_SCHEMA=your_schema_name
SNOWFLAKE_WAREHOUSE=your_warehouse_name
SNOWFLAKE_ROLE=your_role_name

# Snowflake Authentication (choose one method)
# Option 1: Private Key File Path
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/your/private_key.pem

# Option 2: Private Key as Base64 String
SNOWFLAKE_PRIVATE_KEY_BASE64=your_base64_encoded_private_key_here

# PostgreSQL Database (for job tracking)
DATABASE_URL=postgresql://username:password@hostname:port/database_name

# Example DATABASE_URL format:
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
# DATABASE_URL=postgresql://user:pass@host.example.com:5432/dbname
